filter(Semestr == "Z" & zapsáno.celkem > 75) %>% # pouze povinné předměty
arrange(splněno.procento)
t_zs_p %>%
select(-forma, -konzultační.středisko, -Ročník, -Semestr) %>%
kable(lablel="Prezenční studium, 1r. ZS, povinné předměty")
