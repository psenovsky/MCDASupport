prvni_r <- read.csv("1r.csv", sep=";") %>%
filter(Ročník == 1) %>% # jen první ročník
filter(zapsáno.celkem > 0) %>% # pokud si předmět nikdo nezapsal nemusí být v datasetu
select(forma, konzultační.středisko, Číslo, Název, Ročník, Semestr, Zakončení, zapsáno.celkem, splněno.celkem, splněno.procento,
pokus.o.vykonání.zkoušky.žádný)
